# dependencies
node_modules/

# expo / metro output
.expo/
dist/
web-build/
*.log

# native projects are generated by `expo prebuild` from app.json + plugins;
# committing them makes the generated copy the source of truth by accident
synapse/android/
synapse/ios/

# Gradle writes each local Expo module's build output next to its sources;
# only CI used to build, so nothing ever produced these until a local build did
synapse/modules/*/android/build/
synapse/modules/*/android/.cxx/

# the partial gradle copy in materials is build junk, not source
materials/base/android/

# MediaPipe's web runtime and the pose model, copied from node_modules and
# the Android assets by synapse/scripts/web-vision-assets.js
synapse/public/mediapipe/

# machine-local tooling
.claude/
.DS_Store
export_log.txt

# a local library of agent skills (~520 MB, thousands of third-party skills);
# a tool for working on the repo, not part of the product
SKILLS/
